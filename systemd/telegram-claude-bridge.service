# On-demand user unit. It deliberately has no [Install] section, so
# `systemctl --user enable` refuses it: the bridge must never start by itself.
#
# Template: do not edit it. Setup (once, and again after moving the checkout):
#   systemd/install-unit.sh
# which fills in the checkout path and the directories of uv and claude.
# Use:
#   systemctl --user start telegram-claude-bridge
#   systemctl --user stop telegram-claude-bridge

[Unit]
Description=Telegram <-> Claude Code bridge (manual start only)

[Service]
Type=simple
WorkingDirectory=/path/to/telegram-claude-bridge
ExecStart=/path/to/telegram-claude-bridge/start.sh
# systemd user services get a minimal PATH; install-unit.sh prepends uv and claude.
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=no
