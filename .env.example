# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user ID (from @userinfobot). Comma-separated for more users.
ALLOWED_USERS=
# Sandbox root: every project is a direct sub-directory of this path.
APPROVED_DIRECTORY=/home/<user>/progetti_lavoro
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob,Bash,Edit,Write
CLAUDE_AUTO_APPROVE_TOOLS=Read,Grep,Glob,LS
# Inactivity timeout of a Claude turn (time spent waiting for your approval is not counted).
CLAUDE_TIMEOUT_SECONDS=300
APPROVAL_TIMEOUT_SECONDS=300
VERBOSE_LEVEL=1
DB_PATH=./data/bridge.db
LOG_LEVEL=INFO
# Optional: path of the claude binary if it is not the one found in PATH.
CLAUDE_BIN=claude
# Optional: only if you want pay-per-use API billing instead of the CLI subscription login.
ANTHROPIC_API_KEY=
